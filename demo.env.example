APP_NAME="Kashtre Demo"
APP_ENV=demo
APP_KEY=
APP_DEBUG=true
APP_URL=https://demo.kashtre.com

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=demo_kashtre
DB_USERNAME=demo_user
DB_PASSWORD=demo_password

BROADCAST_DRIVER=reverb
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="demo@kashtre.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Third Party API Configuration
THIRD_PARTY_API_URL=http://127.0.0.1:8001
THIRD_PARTY_API_TIMEOUT=30

# Demo calling service
CALLING_SERVICE_URL=https://calling-demo.kashtre.com
CALLING_SERVICE_SYNC_SECRET=

# Reverb / broadcasting
REVERB_APP_ID=kashtre
REVERB_APP_KEY=kashtre-reverb-key
REVERB_APP_SECRET=
REVERB_HOST=reverb.kashtre.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_VERIFY_TLS=true
REVERB_SERVER=reverb
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_SCALING_ENABLED=false
REVERB_SCALING_CHANNEL=reverb
REVERB_PULSE_INGEST_INTERVAL=15
REVERB_TELESCOPE_INGEST_INTERVAL=15
REVERB_APP_PING_INTERVAL=60
REVERB_APP_ACTIVITY_TIMEOUT=100
REVERB_APP_MAX_MESSAGE_SIZE=10000

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# WebRTC / ICE
VITE_WEBRTC_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
VITE_WEBRTC_TURN_URL=
VITE_WEBRTC_TURN_USERNAME=
VITE_WEBRTC_TURN_CREDENTIAL=
VITE_WEBRTC_ICE_TRANSPORT_POLICY=all

# Optional legacy pusher fallback
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Demo-specific settings
DEMO_MODE=true
DEMO_NOTIFICATIONS=true
TWO_FACTOR_ENABLED=false
REQUIRE_TWO_FACTOR=false
