APP_NAME="Kashtre"
APP_ENV=testing
APP_KEY=base64:04D7R5MdOvHHIEt6hBt0uoBZ3p4gmdm+Zz1QL4M2g+o=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# Isolated test database — never the real dev 'kashtre' DB. RefreshDatabase
# runs migrate:fresh (drops every table) the first time any test in a
# process uses it, so this MUST stay pointed at a disposable database.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kashtre_testing
DB_USERNAME=root
DB_PASSWORD=

# The 'clinical' connection gets its OWN physical database here (unlike
# dev/.env, where it deliberately shares one with 'mysql'). Reason: several
# existing tests use RefreshDatabase, which runs migrate:fresh against the
# default connection's database — since that drops every table it can see,
# a shared database would wipe clinical_*/cde_* tables too, and nothing
# re-creates them (database/migrations/clinical is deliberately NOT
# auto-registered — see Chunk 0). A separate database sidesteps this
# instead of fighting migrate:fresh's blast radius.
CLINICAL_DB_HOST=127.0.0.1
CLINICAL_DB_PORT=3306
CLINICAL_DB_DATABASE=kashtre_testing_clinical
CLINICAL_DB_USERNAME=root
CLINICAL_DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=array
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
SESSION_LIFETIME=120

MAIL_MAILER=array

LOG_CHANNEL=stack
LOG_LEVEL=debug

BCRYPT_ROUNDS=4

DISPATCH_DRIVER=local
HR_MODULE_API_KEY=kashtre-hr-secret-2026
IMAGING_MODULE_API_KEY=kashtre-imaging-secret-2026
