    {"code": "H", "name": "hour", "symbol": "h", "class": "DERIVED_NAMED", "quantityKind": "TIME", "dimension": {"T": 1}, "scale": "3600", "ucum": "h", "reference": "S"},
    {"code": "CEL", "name": "degree Celsius", "symbol": "Cel", "class": "OFFSET_SCALE", "quantityKind": "TEMPERATURE", "dimension": {"TEMP": 1}, "scale": "1", "offset": "0", "ucum": "Cel"},
