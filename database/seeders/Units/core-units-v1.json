    {"code": "BOTTLE", "name": "bottle", "symbol": "btl", "class": "PACKAGING_CONTEXTUAL", "quantityKind": "COUNT", "dimension": {"COUNT": 1}, "scale": "1", "ucum": "{bottle}"},
    {"code": "STRIP", "name": "strip", "symbol": "strip", "class": "PACKAGING_CONTEXTUAL", "quantityKind": "COUNT", "dimension": {"COUNT": 1}, "scale": "1", "ucum": "{strip}"},
