    {"code": "MG_PER_DL", "name": "milligram per decilitre", "symbol": "mg/dL", "class": "COMPOSITE_RATIO", "quantityKind": "CONCENTRATION", "dimension": {"M": 1, "L": -3}, "scale": "1", "ucum": "mg/dL", "components": [{"operator": "NUMERATOR", "unit": "MG", "exponent": 1}, {"operator": "DENOMINATOR", "unit": "DL", "exponent": 1}]},
    {"code": "UG_PER_ML", "name": "microgram per millilitre", "symbol": "ug/mL", "class": "COMPOSITE_RATIO", "quantityKind": "CONCENTRATION", "dimension": {"M": 1, "L": -3}, "scale": "1", "ucum": "ug/mL", "components": [{"operator": "NUMERATOR", "unit": "UG", "exponent": 1}, {"operator": "DENOMINATOR", "unit": "ML", "exponent": 1}]},
    {"code": "G_PER_L", "name": "gram per litre", "symbol": "g/L", "class": "COMPOSITE_RATIO", "quantityKind": "CONCENTRATION", "dimension": {"M": 1, "L": -3}, "scale": "1", "ucum": "g/L", "components": [{"operator": "NUMERATOR", "unit": "G", "exponent": 1}, {"operator": "DENOMINATOR", "unit": "L", "exponent": 1}]}
